# Redirects, security headers, and caching for the documentation portal.
# This file ships inside the build, so it is versioned with the site it
# describes and travels with every release.

RewriteEngine On

# --- Redirects -------------------------------------------------------------
# The retired documentation site published exactly one page: the Universe
# Wallet provider API. Both the bare route and its Markdown representation.
RewriteRule ^universe-wallet-api\.md$ /developers/wallet-provider-api/ [R=301,L]
RewriteRule ^universe-wallet-api/?$ /developers/wallet-provider-api/ [R=301,L]

<IfModule mod_headers.c>
  # --- Security ------------------------------------------------------------
  # The portal loads nothing from another origin: no CDN, no tracker, no
  # remote font. The policy says so, so a page that starts trying to is
  # blocked rather than silently trusted.
  #
  # 'unsafe-inline' is present for scripts because Starlight inlines the
  # theme-selection script that runs before first paint to avoid a flash of
  # the wrong theme, and for styles because Astro inlines critical CSS. Both
  # are build output rather than user or third-party content. Every origin
  # directive stays locked to self, which is the part that stops exfiltration.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # Documentation needs none of these. Denying them means an embedded example
  # cannot quietly ask for them either.
  Header always set Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()"

  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"

  # --- Caching -------------------------------------------------------------
  # Build assets carry a content hash in the filename, so they can never go
  # stale under a long cache.
  <FilesMatch "\.[0-9a-zA-Z_-]{8,}\.(css|js|woff2|svg|png|webp|avif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML and the release marker must always be revalidated, otherwise a
  # deployment would not be visible to a returning reader.
  <FilesMatch "\.(html|xml|json|txt)$|^RELEASE$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

ErrorDocument 404 /404.html
