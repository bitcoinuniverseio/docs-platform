---
// The documentation health dashboard.
//
// Generated by tooling/sync/bin/audit.mjs, which walks every repository in the
// portal source registry and records what it found. A repository with no manifest
// is published as exactly that, because a dashboard that only lists the healthy
// repositories is a dashboard nobody can act on.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Aside } from '@astrojs/starlight/components';
import health from '@universe/ecosystem-registry/data/docs-health.json' with { type: 'json' };
import { withBase } from '../../lib/paths';

type HealthRecord = (typeof health.repositories)[number];

const repositories = [...health.repositories].sort((a, b) => {
  // Problems first: this page is a work list, not a scoreboard.
  const score = (r: HealthRecord) => (r.manifest.valid ? 2 : r.manifest.present ? 1 : 0);
  return score(a) - score(b) || a.repository.localeCompare(b.repository);
});

const notIngestable = repositories.filter((r) => !r.manifest.valid);
const ingestable = repositories.filter((r) => r.manifest.valid);
const generated = new Date(health.generatedAt).toISOString().slice(0, 10);

function governanceSummary(record: HealthRecord) {
  const files = Object.entries(record.governance);
  const missing = files.filter(([, present]) => !present).map(([file]) => file);
  if (files.length === 0) return 'not checked';
  return missing.length === 0 ? 'complete' : `missing ${missing.join(', ')}`;
}
---

<StarlightPage
  frontmatter={{
    title: 'Documentation health',
    description:
      'Which repositories in the Bitcoin Universe estate are wired into the documentation portal, which are not yet, and what each one is missing.',
    tableOfContents: { minHeadingLevel: 2, maxHeadingLevel: 2 },
  }}
>
  <p class="lede">
    {health.summary.ingestable} of {health.summary.total} repositories in the source registry publish
    a valid documentation manifest. The rest are listed here with what they are missing.
  </p>

  <Aside type="note" title="Why the gaps are published">
    <p>
      A repository without a valid <code>docs.manifest.json</code> cannot be pinned to an exact commit
      and therefore cannot be ingested by this portal. Hiding those rows would make the estate look
      finished while readers hit dead ends. The gap list is the work list.
    </p>
  </Aside>

  {
    notIngestable.length > 0 && (
      <>
        <h2 id="not-yet-ingestable">Not yet ingestable ({notIngestable.length})</h2>
        <div class="scroll-x">
          <table>
            <thead>
              <tr>
                <th scope="col">Repository</th>
                <th scope="col">Manifest</th>
                <th scope="col">Governance files</th>
              </tr>
            </thead>
            <tbody>
              {notIngestable.map((record) => (
                <tr>
                  <th scope="row">
                    <a href={`https://github.com/${record.repository}`}>
                      {record.repository.replace('bitcoinuniverseio/', '')}
                    </a>
                  </th>
                  <td>
                    {record.manifest.present
                      ? `invalid: ${record.manifest.error}`
                      : 'missing'}
                  </td>
                  <td>{governanceSummary(record)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </>
    )
  }

  <h2 id="ingestable">Wired into the portal ({ingestable.length})</h2>
  <div class="scroll-x">
    <table>
      <thead>
        <tr>
          <th scope="col">Repository</th>
          <th scope="col">Lifecycle</th>
          <th scope="col">Last verified</th>
          <th scope="col">Governance files</th>
        </tr>
      </thead>
      <tbody>
        {
          ingestable.map((record) => (
            <tr>
              <th scope="row">
                <a href={`https://github.com/${record.repository}`}>
                  {record.repository.replace('bitcoinuniverseio/', '')}
                </a>
              </th>
              <td>{record.lifecycle}</td>
              <td>
                {record.lastVerifiedAgeDays == null
                  ? 'not recorded'
                  : record.lastVerifiedAgeDays === 0
                    ? 'today'
                    : `${record.lastVerifiedAgeDays} days ago`}
              </td>
              <td>{governanceSummary(record)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2 id="what-is-checked">What is checked</h2>
  <dl>
    <dt>Manifest present and valid</dt>
    <dd>
      A root <code>docs.manifest.json</code> that validates against the shared schema. Without it the
      portal cannot pin the repository to an exact commit.
    </dd>
    <dt>Lifecycle</dt>
    <dd>
      The repository's own declared state, using the shared{' '}
      <a href={withBase("/status/")}>status vocabulary</a>. A repository declaring <code>stable</code> must also
      declare the release it is stable at.
    </dd>
    <dt>Last verified</dt>
    <dd>
      When a maintainer last checked the manifest against reality. An old date is not a failure, but
      it does tell you how much to trust the surrounding claims.
    </dd>
    <dt>Governance files</dt>
    <dd>
      Presence of <code>README.md</code>, <code>SECURITY.md</code>, <code>CONTRIBUTING.md</code>, and{' '}
      <code>SUPPORT.md</code>. This is a presence check only. A file existing is not a claim that it
      is good.
    </dd>
  </dl>

  <p class="provenance">
    Generated by <code>{health.generatedBy}</code> on {generated}.
  </p>
</StarlightPage>

<style>
  .lede {
    font-size: var(--sl-text-lg);
    color: var(--sl-color-white);
  }
  .scroll-x {
    overflow-x: auto;
    margin-bottom: 2rem;
  }
  .scroll-x table {
    margin: 0;
    min-width: 38rem;
  }
  .provenance {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  dl dt {
    font-weight: 600;
    margin-top: 0.9rem;
  }
  dl dd {
    margin: 0.2rem 0 0;
    color: var(--sl-color-gray-2);
  }
</style>
