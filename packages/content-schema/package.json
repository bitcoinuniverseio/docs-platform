{
  "name": "@universe/content-schema",
  "version": "0.1.0",
  "private": true,
  "description": "Typed manifests, frontmatter schemas, and validators for the Bitcoin Universe documentation platform",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./schemas/docs.manifest.schema.json"
  },
  "bin": {
    "validate-docs-manifest": "./bin/validate-manifest.mjs"
  },
  "scripts": {
    "test": "node test/validate-manifest.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
