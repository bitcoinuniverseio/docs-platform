{
  "name": "@universe/inscribe-learning",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic, browser-safe learning core for Inscribe documentation: schemas, guided planner engine, protocol comparison, recovery state machine, safe deep links, stable guide and step identities, progress serialization, and public estimation primitives",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./estimate": {
      "types": "./dist/estimate/index.d.ts",
      "default": "./dist/estimate/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    },
    "./manifest.json": "./data/inscribe-learning.manifest.json"
  },
  "files": [
    "dist",
    "data",
    "src",
    "README.md"
  ],
  "dependencies": {
    "valibot": "^1.4.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate:manifest": "node bin/generate-learning-manifest.mjs",
    "pack:deterministic": "node bin/pack-deterministic.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "@types/node": "^24.0.0"
  }
}
